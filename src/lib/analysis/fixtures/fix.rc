1 ICON "app.ico"
1 24 "app.manifest"
STRINGTABLE
BEGIN
  1 "first string"
  17 "seventeenth"
END
100 DIALOGEX 0, 0, 200, 80
CAPTION "EchoDebug Fixture"
FONT 9, "Segoe UI"
BEGIN
  DEFPUSHBUTTON "OK", 1, 70, 50, 60, 14
  LTEXT "Hello", 2, 10, 10, 100, 10
END
1 VERSIONINFO
FILEVERSION 1,2,3,4
PRODUCTVERSION 1,2,0,0
FILEFLAGSMASK 0x3f
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "EchoDebug Tests"
      VALUE "FileDescription", "Resource fixture"
      VALUE "FileVersion", "1.2.3.4"
      VALUE "ProductName", "EchoDebug"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
